      <field name="json_value">"0"</field>
    </record>
    <record id="default_165_x_consignment_charge_h_x_studio_ledger_post" model="ir.default">
      <field name="field_id" ref="BugFix-Accounting.field_x_consignment_charge_h__x_studio_ledger_post"/>

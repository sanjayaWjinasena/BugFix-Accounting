<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <!-- Financial reports made by hand on upgrade-testing (Rohana, 2026-07-08) and moved into code on
     2026-10-27: definitions as they stood there, plus a report action and a menu under
     Accounting > Reporting. migrations/17.0.0.0.150/pre-migrate.py adopts the existing records. -->
  <record id="account_report_purchasing_cost" model="account.report">
    <field name="name">Purchasing Cost</field>
    <field name="sequence" eval="0"/>
    <field name="active" eval="True"/>
    <field name="availability_condition">always</field>
    <field name="default_opening_date_filter">this_year</field>
    <field name="filter_account_type">disabled</field>
    <field name="filter_aml_ir_filters" eval="False"/>
    <field name="filter_analytic" eval="True"/>
    <field name="filter_analytic_groupby" eval="True"/>
    <field name="filter_date_range" eval="True"/>
    <field name="filter_fiscal_position" eval="False"/>
    <field name="filter_growth_comparison" eval="True"/>
    <field name="filter_hide_0_lines">optional</field>
    <field name="filter_hierarchy">optional</field>
    <field name="filter_journals" eval="True"/>
    <field name="filter_multi_company">selector</field>
    <field name="filter_partner" eval="True"/>
    <field name="filter_period_comparison" eval="True"/>
    <field name="filter_show_draft" eval="True"/>
    <field name="filter_unfold_all" eval="True"/>
    <field name="filter_unreconciled" eval="False"/>
    <field name="load_more_limit" eval="0"/>
    <field name="only_tax_exigible" eval="False"/>
    <field name="prefix_groups_threshold" eval="0"/>
    <field name="search_bar" eval="False"/>
    <field name="use_sections" eval="False"/>
    <field name="column_ids">
      <record id="account_report_purchasing_cost_column_balance" model="account.report.column">
        <field name="name">Balance</field>
        <field name="expression_label">balance</field>
        <field name="figure_type">monetary</field>
        <field name="sequence" eval="0"/>
        <field name="blank_if_zero" eval="True"/>
        <field name="sortable" eval="False"/>
      </record>
    </field>
    <field name="line_ids">
      <record id="account_report_purchasing_cost_line_gp" model="account.report.line">
        <field name="name">GROSS PURCHASES</field>
        <field name="code">GP</field>
        <field name="sequence" eval="1"/>
        <field name="hierarchy_level" eval="0"/>
        <field name="groupby" eval="False"/>
        <field name="user_groupby" eval="False"/>
        <field name="foldable" eval="False"/>
        <field name="hide_if_zero" eval="False"/>
        <field name="print_on_new_page" eval="False"/>
        <field name="expression_ids">
          <record id="account_report_purchasing_cost_line_gp_balance" model="account.report.expression">
            <field name="label">balance</field>
            <field name="engine">domain</field>
            <field name="formula">[('journal_id.code','in',['VNBIL','ADVP','TPBIL','VBPJA','VBPJS']),('move_id.move_type','=','in_invoice'),('display_type','not in',['line_section','line_note']),('account_id.account_type','!=','liability_payable'),('parent_state','=','posted')]</field>
            <field name="subformula">sum</field>
            <field name="date_scope">strict_range</field>
            <field name="figure_type" eval="False"/>
            <field name="green_on_positive" eval="True"/>
            <field name="blank_if_zero" eval="False"/>
            <field name="auditable" eval="True"/>
            <field name="carryover_target" eval="False"/>
          </record>
        </field>
      </record>
      <record id="account_report_purchasing_cost_line_fi" model="account.report.line">
        <field name="name">FREIGHT-IN (LANDED COST)</field>
        <field name="code">FI</field>
        <field name="sequence" eval="2"/>
        <field name="hierarchy_level" eval="0"/>
        <field name="groupby" eval="False"/>
        <field name="user_groupby" eval="False"/>
        <field name="foldable" eval="False"/>
        <field name="hide_if_zero" eval="False"/>
        <field name="print_on_new_page" eval="False"/>
        <field name="expression_ids">
          <record id="account_report_purchasing_cost_line_fi_balance" model="account.report.expression">
            <field name="label">balance</field>
            <field name="engine">domain</field>
            <field name="formula">[('id','=', 0)]</field>
            <field name="subformula">sum</field>
            <field name="date_scope">strict_range</field>
            <field name="figure_type" eval="False"/>
            <field name="green_on_positive" eval="True"/>
            <field name="blank_if_zero" eval="False"/>
            <field name="auditable" eval="True"/>
            <field name="carryover_target" eval="False"/>
          </record>
        </field>
      </record>
      <record id="account_report_purchasing_cost_line_pr" model="account.report.line">
        <field name="name">PURCHASE RETURNS &amp; ALLOWANCES</field>
        <field name="code">PR</field>
        <field name="sequence" eval="3"/>
        <field name="hierarchy_level" eval="0"/>
        <field name="groupby" eval="False"/>
        <field name="user_groupby" eval="False"/>
        <field name="foldable" eval="False"/>
        <field name="hide_if_zero" eval="False"/>
        <field name="print_on_new_page" eval="False"/>
        <field name="expression_ids">
          <record id="account_report_purchasing_cost_line_pr_balance" model="account.report.expression">
            <field name="label">balance</field>
            <field name="engine">domain</field>
            <field name="formula">[('journal_id.code','in',['VNBIL','ADVP','TPBIL','VBPJA','VBPJS']),('move_id.move_type','=','in_refund'),('display_type','not in',['line_section','line_note']),('account_id.account_type','!=','liability_payable'),('parent_state','=','posted')]</field>
            <field name="subformula">-sum</field>
            <field name="date_scope">strict_range</field>
            <field name="figure_type" eval="False"/>
            <field name="green_on_positive" eval="True"/>
            <field name="blank_if_zero" eval="False"/>
            <field name="auditable" eval="True"/>
            <field name="carryover_target" eval="False"/>
          </record>
        </field>
      </record>
      <record id="account_report_purchasing_cost_line_pd" model="account.report.line">
        <field name="name">PURCHASE DISCOUNTS</field>
        <field name="code">PD</field>
        <field name="sequence" eval="4"/>
        <field name="hierarchy_level" eval="0"/>
        <field name="groupby" eval="False"/>
        <field name="user_groupby" eval="False"/>
        <field name="foldable" eval="False"/>
        <field name="hide_if_zero" eval="False"/>
        <field name="print_on_new_page" eval="False"/>
        <field name="expression_ids">
          <record id="account_report_purchasing_cost_line_pd_balance" model="account.report.expression">
            <field name="label">balance</field>
            <field name="engine">domain</field>
            <field name="formula">[('id','=', 0)]</field>
            <field name="subformula">sum</field>
            <field name="date_scope">strict_range</field>
            <field name="figure_type" eval="False"/>
            <field name="green_on_positive" eval="True"/>
            <field name="blank_if_zero" eval="False"/>
            <field name="auditable" eval="True"/>
            <field name="carryover_target" eval="False"/>
          </record>
        </field>
      </record>
      <record id="account_report_purchasing_cost_line_npc" model="account.report.line">
        <field name="name">NET PURCHASE COST</field>
        <field name="code">NPC</field>
        <field name="sequence" eval="5"/>
        <field name="hierarchy_level" eval="0"/>
        <field name="groupby" eval="False"/>
        <field name="user_groupby" eval="False"/>
        <field name="foldable" eval="False"/>
        <field name="hide_if_zero" eval="False"/>
        <field name="print_on_new_page" eval="False"/>
        <field name="expression_ids">
          <record id="account_report_purchasing_cost_line_npc_balance" model="account.report.expression">
            <field name="label">balance</field>
            <field name="engine">aggregation</field>
            <field name="formula">GP.balance+FI.balance-PR.balance-PD.balance</field>
            <field name="subformula" eval="False"/>
            <field name="date_scope">strict_range</field>
            <field name="figure_type" eval="False"/>
            <field name="green_on_positive" eval="True"/>
            <field name="blank_if_zero" eval="False"/>
            <field name="auditable" eval="True"/>
            <field name="carryover_target" eval="False"/>
          </record>
        </field>
      </record>
    </field>
  </record>
  <record id="action_report_purchasing_cost" model="ir.actions.client">
    <field name="name">Purchasing Cost</field>
    <field name="tag">account_report</field>
    <field name="context" eval="{'report_id': ref('account_report_purchasing_cost')}"/>
  </record>
  <menuitem id="menu_report_purchasing_cost" name="Purchasing Cost" parent="account.account_reports_management_menu" action="action_report_purchasing_cost" sequence="100"/>
  <record id="account_report_sales_summary" model="account.report">
    <field name="name">Sales Summary</field>
    <field name="sequence" eval="0"/>
    <field name="active" eval="True"/>
    <field name="availability_condition">always</field>
    <field name="default_opening_date_filter">last_month</field>
    <field name="filter_account_type">disabled</field>
    <field name="filter_aml_ir_filters" eval="False"/>
    <field name="filter_analytic" eval="False"/>
    <field name="filter_analytic_groupby" eval="False"/>
    <field name="filter_date_range" eval="True"/>
    <field name="filter_fiscal_position" eval="False"/>
    <field name="filter_growth_comparison" eval="True"/>
    <field name="filter_hide_0_lines">optional</field>
    <field name="filter_hierarchy">optional</field>
    <field name="filter_journals" eval="False"/>
    <field name="filter_multi_company">disabled</field>
    <field name="filter_partner" eval="False"/>
    <field name="filter_period_comparison" eval="True"/>
    <field name="filter_show_draft" eval="True"/>
    <field name="filter_unfold_all" eval="True"/>
    <field name="filter_unreconciled" eval="False"/>
    <field name="load_more_limit" eval="0"/>
    <field name="only_tax_exigible" eval="False"/>
    <field name="prefix_groups_threshold" eval="0"/>
    <field name="search_bar" eval="False"/>
    <field name="use_sections" eval="False"/>
    <field name="column_ids">
      <record id="account_report_sales_summary_column_balance" model="account.report.column">
        <field name="name">Date</field>
        <field name="expression_label">balance</field>
        <field name="figure_type">monetary</field>
        <field name="sequence" eval="1"/>
        <field name="blank_if_zero" eval="True"/>
        <field name="sortable" eval="False"/>
      </record>
      <record id="account_report_sales_summary_column_fy_end" model="account.report.column">
        <field name="name">Year to Date</field>
        <field name="expression_label">fy_end</field>
        <field name="figure_type">monetary</field>
        <field name="sequence" eval="2"/>
        <field name="blank_if_zero" eval="True"/>
        <field name="sortable" eval="False"/>
      </record>
    </field>
    <field name="line_ids">
      <record id="account_report_sales_summary_line_sales" model="account.report.line">
        <field name="name">SALES</field>
        <field name="code">SALES</field>
        <field name="sequence" eval="1"/>
        <field name="hierarchy_level" eval="0"/>
        <field name="groupby" eval="False"/>
        <field name="user_groupby">x_studio_sales_team</field>
        <field name="foldable" eval="False"/>
        <field name="hide_if_zero" eval="False"/>
        <field name="print_on_new_page" eval="False"/>
        <field name="expression_ids">
          <record id="account_report_sales_summary_line_sales_balance" model="account.report.expression">
            <field name="label">balance</field>
            <field name="engine">domain</field>
            <field name="formula">[('move_id.move_type','=','out_invoice'),('parent_state','=','posted'),('account_id.account_type','in',['income','income_other'])]</field>
            <field name="subformula">-sum</field>
            <field name="date_scope">strict_range</field>
            <field name="figure_type" eval="False"/>
            <field name="green_on_positive" eval="True"/>
            <field name="blank_if_zero" eval="False"/>
            <field name="auditable" eval="True"/>
            <field name="carryover_target" eval="False"/>
          </record>
          <record id="account_report_sales_summary_line_sales_fy_end" model="account.report.expression">
            <field name="label">fy_end</field>
            <field name="engine">domain</field>
            <field name="formula">[('move_id.move_type','=','out_invoice'),('parent_state','=','posted'),('account_id.account_type','in',['income','income_other'])]</field>
            <field name="subformula">-sum</field>
            <field name="date_scope">from_fiscalyear</field>
            <field name="figure_type" eval="False"/>
            <field name="green_on_positive" eval="True"/>
            <field name="blank_if_zero" eval="False"/>
            <field name="auditable" eval="True"/>
            <field name="carryover_target" eval="False"/>
          </record>
        </field>
      </record>
    </field>
  </record>
  <record id="action_report_sales_summary" model="ir.actions.client">
    <field name="name">Sales Summary</field>
    <field name="tag">account_report</field>
    <field name="context" eval="{'report_id': ref('account_report_sales_summary')}"/>
  </record>
  <menuitem id="menu_report_sales_summary" name="Sales Summary" parent="account.account_reports_management_menu" action="action_report_sales_summary" sequence="101"/>
</odoo>

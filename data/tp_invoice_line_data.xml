<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="sa_f5_x_tp_invoice_line_tp_invoice_linetax_update" model="ir.actions.server">
    <field name="name">TP Invoice LineTAX Update</field>
    <field name="model_id" search="[('model', '=', 'tp_invoice_line')]"/>
    <field name="state">code</field>
    <field name="code"><![CDATA[#if record.taxes.id:
taxes = 0
if record.taxes != []:
  for ids in record.taxes:
    tax= env['account.tax'].search([('id', '=', ids._origin.id)], limit=1)
    if tax:
      taxes += record.invoice_amount * (tax.amount / 100)
 
record.write({'tax_amount':taxes})
   




]]></field>
    <field name="usage">base_automation</field>
    <field name="binding_view_types">list,form</field>
  </record>

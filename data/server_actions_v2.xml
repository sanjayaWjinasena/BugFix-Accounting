    <!-- ==================================================== -->
    <!-- Window actions (2) — ported verbatim from Clear-DB   -->
    <!-- ==================================================== -->

    <record id="act_dispatch_reversal" model="ir.actions.act_window">
        <field name="name">Dispatch Reversal</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('x_studio_created_from_vendor_bill', '=', active_id)]</field>
        <field name="context">{'search_default_x_studio_created_from_vendor_bill': active_id, 'default_x_studio_created_from_vendor_bill': active_id}</field>
    </record>

    <record id="act_custom_clearance_reversal" model="ir.actions.act_window">
        <field name="name">Custom Clearance Reversal</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('x_studio_created_from_vendor_bill_1', '=', active_id)]</field>
        <field name="context">{'search_default_x_studio_created_from_vendor_bill_1': active_id, 'default_x_studio_created_from_vendor_bill_1': active_id}</field>
    </record>

</odoo>

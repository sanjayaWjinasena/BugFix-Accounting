    </record>

    <record id="srv_imp_vendor_bill_currency_rate" model="ir.actions.server">
        <field name="name">IMP - Vendor Bill Currency Rate</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>

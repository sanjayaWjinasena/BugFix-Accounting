    </record>

    <record id="srv_sls_request_credit_note_approval" model="ir.actions.server">
        <field name="name">SLS - Request Credit Note Approval</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">raise UserError("BugFix-Accounting: Request Credit Note Approval action stub — full port pending (state=multi with child actions on Clear-DB). Clear-DB action id was 1493.")</field>
    </record>

    <record id="srv_sls_credit_note_approval_main" model="ir.actions.server">
        <field name="name">SLS - Credit Note Approval - Main</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>

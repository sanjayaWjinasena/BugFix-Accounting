<?xml version="1.0" encoding="utf-8"?>
<!--
    6 Studio QWeb reports ported from Clear-DB (v0.0.46).

    Correspondence (Clear-DB action id -> local xmlid):
      3455 -> action_report_payment_receipt  (Jinasena Payment Receipt on account.payment)
      3469 -> action_report_journal_entry_1  (Journal Entry Report on account.move)
      3470 -> action_report_journal_entry_2  (Journal Entry Report on account.move)
      3468 -> action_report_pro_forma_invoice  (Pro forma Invoice on account.move)
      3454 -> action_report_account_payment_1  (account.payment Report on account.payment)
      3456 -> action_report_account_payment_2  (account.payment Report on account.payment)

    Each report has two <template> records: a thin main wrapper
    (used as report_name) and the _document body. The main wrapper
    just iterates docs and t-calls into the _document; the body
    holds the layout. Byte-verbatim from Clear-DB except:
      * <t t-name="..."> wrappers replaced by <template id=...>
        which auto-sets type=qweb.
      * cross-template t-call refs rewritten from
        "studio_customization.studio_report_docume_UUID_document"
        to "BugFix-Accounting.report_SLUG_document".

    Body-content notes:
      * 3455 (payment_receipt): Full A4-statement receipt with company header, receipt no, customer info, amount, cheque, stamp-duty footer.
      * 3469 (journal_entry_1): Empty Studio stub (128-byte body). Kept for parity because operators may still have the print binding wired to it.
      * 3470 (journal_entry_2): Full Pro-Forma-Invoice template (~10 KB). Named "Journal Entry Report" in the print menu but the body renders a Pro-Forma Invoice; keep the mislabel for byte-parity.
      * 3468 (pro_forma_invoice): Empty Studio stub (128-byte body). Real Pro-Forma content lives in journal_entry_2 (3470).
      * 3454 (account_payment_1): Empty Studio stub (210-byte body, internal_layout wrapped).
      * 3456 (account_payment_2): Empty Studio stub (210-byte body, internal_layout wrapped).
-->
<odoo>

    <!-- Clear-DB action 3455: Jinasena Payment Receipt -->
    <template id="report_payment_receipt">
                    <t t-call="web.html_container">
                        <t t-foreach="docs" t-as="doc">
                            <t t-call="BugFix-Accounting.report_payment_receipt_document"/>
                        </t>
                    </t>
    </template>
    <template id="report_payment_receipt_document"><t t-foreach="docs" t-as="doc">
  <div class="page" style="font-family: 'Segoe UI', Arial, sans-serif; font-size: 10pt; height: 5.5in; width: 8.5in; padding: 20px 25px; box-sizing: border-box; background: white;">
    
    <!-- HEADER -->
    <div class="report-header" style="padding-bottom: 12px; margin-bottom: 18px; border-bottom: 2px solid #333;">
      <table style="width: 100%; border-collapse: collapse;" cellspacing="0" cellpadding="0">
        <tr>
          <td style="width: 90px; vertical-align: top; padding: 0;">
            <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 85px; max-width: 85px; display: block;"/>
          </td>
          <td style="width: 3px; background: linear-gradient(to bottom, #1a1a1a, #4a4a4a); padding: 0; margin: 0 12px;"/>
          <td style="padding-left: 12px; font-size: 8.5pt; line-height: 1.4; color: #333;">
            <div style="font-weight: bold; font-size: 13pt; color: #000; margin-bottom: 4px;">JINASENA</div>
            <div>No:186, Elvitigala Mawatha, Colombo 08. | Hotline: 0112688966, 0112684912 | Fax: 0112688969</div>
            <div>Repair &amp; Service Hotline: 0740600700 | Sales &amp; Marketing Hotline: 0740600600</div>
            <div>E-mail: jinasena@jinasena.com.lk | Web: www.jinasena.com</div>
            <div>Business Reg.No: PV3568 | VAT Reg.No: 1040249557000 | SVAT Reg.No: 001873</div>
          </td>
        </tr>
      </table>
    </div>
    
    <!-- TITLE -->
    <div style="text-align: center; font-size: 16pt; font-weight: bold; margin-bottom: 15px; color: #1a1a1a; letter-spacing: 1px;">RECEIPT</div>
    
    <!-- RECEIPT NUMBER -->
    <div style="font-size: 10pt; margin-bottom: 18px; background: #f8f9fa; padding: 8px 12px; border-left: 3px solid #333;">
      <strong>Receipt No:</strong> <span t-esc="doc.name"/>
    </div>
    
    <!-- CUSTOMER INFO -->
    <table style="width: 100%; margin-bottom: 18px; font-size: 10pt; background: #f8f9fa; border-radius: 4px;">
      <tr>
        <td style="width: 35%; vertical-align: top; padding: 10px; font-weight: 600; color: #555;">Received with thanks from:</td>
        <td style="width: 65%; vertical-align: top; padding: 10px; color: #333;">
          <div style="font-weight: bold; font-size: 10.5pt; color: #000; margin-bottom: 3px;">
            <t t-esc="doc.partner_id.name"/>
          </div>
          <t t-esc="doc.partner_id.street or ''"/><br/>
          <t t-if="doc.partner_id.street2"><t t-esc="doc.partner_id.street2"/>,<br/></t>
          <t t-if="doc.partner_id.city"><t t-esc="doc.partner_id.city"/></t>
        </td>
      </tr>
    </table>
    
    <!-- AMOUNT -->
    <table style="width: 100%; margin-bottom: 18px; font-size: 10pt; border: 2px solid #e0e0e0; border-radius: 4px; background: white;">
      <tr>
        <td style="width: 65%; padding: 12px; vertical-align: middle;">
          <div style="color: #555; font-size: 9pt; margin-bottom: 2px;">Amount in words:</div>
          <div style="font-weight: 600; color: #000;">
            The sum of Rupees <span t-esc="(doc.amount_total_words or 'Zero') + ' Only'"/>
          </div>
        </td>
        <td style="width: 35%; text-align: right; padding: 12px; background: #f8f9fa; border-left: 2px solid #e0e0e0; vertical-align: middle;">
          <div style="color: #555; font-size: 9pt; margin-bottom: 2px;">Amount:</div>
          <div style="font-size: 14pt; font-weight: bold; color: #000;">
            Rs. <span t-esc="'{:,.2f}'.format(doc.amount_total)"/>
          </div>
        </td>
      </tr>
    </table>
    
    <!-- PAYMENT DETAILS -->
    <div style="margin-bottom: 18px; font-size: 10pt; padding: 10px; background: #f8f9fa; border-radius: 4px;">
      <div style="margin-bottom: 6px;">
        <span style="display: inline-block; width: 120px; color: #555;">Cheque No:</span>
        <span style="font-weight: 600; color: #000;" t-esc="doc.ref or ''"/>
      </div>
      <div>
        <span style="display: inline-block; width: 120px; color: #555;">Cheque Date:</span>
        <span style="font-weight: 600; color: #000;">___________________</span>
      </div>
    </div>
    
    <!-- NOTICE -->
    <div style="font-size: 9pt; margin-bottom: 18px; padding: 10px; background: #fff8e1; border-left: 3px solid #ffc107; color: #333; line-height: 1.5;">
      <strong style="color: #000;">Important:</strong> This receipt must be surrendered to us at the time of making final payment.
      If this receipt is lost, a sworn affidavit must be submitted.
    </div>
    
    <!-- FOOTER -->
    <table style="width: 100%; font-size: 9pt;">
      <tr>
        <td style="width: 42%; vertical-align: top; border: 2px solid #333; padding: 12px; background: white; border-radius: 4px;">
          <div style="text-align: center; font-weight: bold; margin-bottom: 8px; font-size: 10pt; color: #000;">JINASENA (PVT) LTD</div>
          <div style="margin-bottom: 4px;">Stamp Duty Rs: _____________</div>
          <div style="text-align: center; margin-top: 8px; font-weight: 600;">Compounded in Terms</div>
          <div style="text-align: center; font-weight: 600;">SD (SPECIAL PROVISIONS)</div>
          <div style="text-align: center; font-weight: 600;">Act No 12 OF 2006</div>
        </td>
        <td style="width: 58%; vertical-align: bottom; text-align: right; padding-left: 20px;">
          <div style="margin-bottom: 6px; font-size: 10pt;">
            <span style="color: #555;">REF No:</span> 
            <span style="font-weight: 600; color: #000;" t-esc="doc.invoice_origin or ''"/>
          </div>
          <div style="margin-bottom: 45px; font-size: 10pt;">
            <span style="color: #555;">DATE:</span> 
            <span style="font-weight: 600; color: #000;" t-esc="doc.date" t-options="{'widget': 'date'}"/>
          </div>
          <div style="display: inline-block; min-width: 220px; text-align: center;">
            <div style="border-top: 2px solid #333; padding-top: 6px; font-weight: 600; color: #000;">
              Cashier Signature
            </div>
          </div>
        </td>
      </tr>
    </table>
    
  </div>
</t>
    </template>

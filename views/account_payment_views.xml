  <record id="action_2629_payments" model="ir.actions.act_window">
    <field name="name">Payments</field>
    <field name="res_model">account.payment</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('project_no_1', '=', active_id)]</field>
    <field name="context">{'search_default_project_no_1': active_id,'default_project_no_1': active_id}</field>
  </record>
    <record id="ported_view_3066_odoo_studio_account_b5367f7f_470f_43eb_bfb4_583117888f1f" model="ir.ui.view">
        <field name="name">Odoo Studio: account.payment.form customization</field>
        <field name="model">account.payment</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//button[@name='action_void_check']" position="after">
                <button type="action" name="%(BugFix-Accounting.srv_advance_payment_acc_update)d" string="Update Advance Payment Account" class="btn-primary" invisible="((advance_payment_acc_updated == True) and (type == 'Advance Payment')) or (type != 'Advance Payment')"/>
              </xpath>
              <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="invisible">(state != 'draft') or ((advance_payment_acc_updated == False) and (type == 'Advance Payment'))</attribute></xpath>
              <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="type" string="Type" readonly="state != 'draft'"/>
              </xpath>
              <xpath expr="//form[1]/sheet[1]/group[1]/group[@name='group2']/field[@name='partner_bank_id']" position="after">
                <field name="sales_order" string="Sales Order" domain="[('partner_id', '=', partner_id)]" readonly="(partner_id == False) or (state != 'draft')"/>
                <field name="project_no_1" string="Project No" readonly="(state != 'draft') or (created_from_project_1 == True)"/>
                <field name="created_from_project_1" string="Created From Project" force_save="True" readonly="1" invisible="1"/>
                <field name="lc_no_1" string="LC No" domain="[('vendor', '=', partner_id),('status', '=', 'Posted')]" readonly="state != 'draft'"/>
                <field name="purchase_order" string="Purchase Order" force_save="True" domain="[('partner_id', '=', partner_id)]" readonly="(partner_id == False) or (state != 'draft')"/>
                <field name="tp_invoice_no" string="TP Invoice No" domain="[('vendor', '=', partner_id)]" readonly="(partner_id == False) or (state != 'draft')"/>
                <field name="payment_validation" string="Payment Validation" force_save="True" readonly="1" invisible="1"/>
              </xpath>
              <xpath expr="//field[@name='payment_transaction_id']" position="after">
                <field name="quotation_type" string="Quotation Type" force_save="True" invisible="1" readonly="1"/>
                <field name="payment_validation_1" string="Payment Validation" force_save="True" readonly="1" invisible="payment_validation == False"/>
                <field name="advance_payment_acc_updated" force_save="True" readonly="1" invisible="1"/>
              </xpath>
            </data>
        </field>
    </record>
    <record id="ported_view_3112_odoo_studio_account_260c28c3_3477_4c4a_a023_77f402c5dabf" model="ir.ui.view">
        <field name="name">Odoo Studio: account.payment.tree customization</field>
        <field name="model">account.payment</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='date']" position="after">
                <field name="ref" optional="show"/>
              </xpath>
              <xpath expr="//field[@name='currency_id']" position="after">
                <field name="id"/>
                <field name="has_reconciled_entries"/>
                <field name="reconciled_statement_lines_count"/>
                <field name="is_reconciled"/>
                <field name="reconciled_invoices_count"/>
                <field name="reconciled_bills_count"/>
                <field name="reconciled_invoice_ids"/>
                <field name="move_id"/>
                <field name="invoice_line_ids"/>
              </xpath>
              <xpath expr="//field[@name='state']" position="after">
                <field name="create_uid" optional="show"/>
              </xpath>
            </data>
        </field>
    </record>

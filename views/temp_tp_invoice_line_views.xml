<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_temp_tp_invoice_line" model="ir.actions.act_window">
    <field name="name">Temp TP Invoice Line</field>
    <field name="res_model">temp_tp_invoice_line</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="view_temp_tp_invoice_line_form" model="ir.ui.view">
    <field name="name">Default form view for temp_tp_invoice_line</field>
    <field name="model">temp_tp_invoice_line</field>
    <field name="key">studio_customization.default_form_view_fo_8e00b755-fbe6-4921-925a-91bb567326d7</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Temp TP Invoice Line">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
          <field name="active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_0b2b4a">
            <group name="studio_group_0b2b4a_left"/>
            <group name="studio_group_0b2b4a_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="view_temp_tp_invoice_line_list" model="ir.ui.view">
    <field name="name">Default list view for temp_tp_invoice_line</field>
    <field name="model">temp_tp_invoice_line</field>
    <field name="key">studio_customization.default_list_view_fo_a6e6b3ad-20ca-4271-b887-d78bf98e2073</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_temp_tp_invoice_line_search" model="ir.ui.view">
    <field name="name">Default search view for temp_tp_invoice_line</field>
    <field name="model">temp_tp_invoice_line</field>
    <field name="key">studio_customization.default_search_view__262de343-80f0-46e9-b0a4-3cbfe09d933f</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <separator/>
        <filter string="Archived" name="archived_temp_tp_invoice_line" domain="[['active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
    <record id="view_temp_tp_invoice_line_search_2" model="ir.ui.view">
        <field name="name">Default search view for temp_tp_invoice_line</field>
        <field name="model">temp_tp_invoice_line</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_temp_tp_invoice_line" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_default_form_view_for_temp_tp_invoice_line_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default form view for temp_tp_invoice_line customization</field>
        <field name="model">temp_tp_invoice_line</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_temp_tp_invoice_line_form"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//group[@name='studio_group_0b2b4a_left']" position="inside">
                <field name="temp_tp_invoice_header_id" string="Temp TP Invoice Header Id" force_save="True" readonly="1"/>
                <field name="accounting_select" string="Select"/>
                <field name="amount" string="Amount"/>
                <field name="basis" string="Basis"/>
                <field name="charge_group" string="Charge Group"/>
                <field name="charge_name" string="Charge Name"/>
                <field name="consignment_id" string="Consignment Id"/>
                <field name="consignment_charge_header_id" string="Consignment Charge Header Id"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>

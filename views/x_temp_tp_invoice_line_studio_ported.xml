                  </div>
          <group name="studio_group_0b2b4a">
            <group name="studio_group_0b2b4a_left"/>
            <group name="studio_group_0b2b4a_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="ported_default_list_view_fo_a6e6b3ad_20ca_4271_b887_d78bf98e2073" model="ir.ui.view">
    <field name="name">Default list view for x_temp_tp_invoice_line</field>
    <field name="model">x_temp_tp_invoice_line</field>
    <field name="key">studio_customization.default_list_view_fo_a6e6b3ad-20ca-4271-b887-d78bf98e2073</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="x_studio_sequence" widget="handle"/>
        <field name="x_name"/>
      </tree>
    </field>
  </record>
  <record id="ported_default_search_view__262de343_80f0_46e9_b0a4_3cbfe09d933f" model="ir.ui.view">
    <field name="name">Default search view for x_temp_tp_invoice_line</field>
    <field name="model">x_temp_tp_invoice_line</field>
    <field name="key">studio_customization.default_search_view__262de343-80f0-46e9-b0a4-3cbfe09d933f</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="x_name"/>
        <separator/>
        <filter string="Archived" name="archived_x_temp_tp_invoice_line" domain="[['x_active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
</odoo>

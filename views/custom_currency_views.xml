<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_custom_currency" model="ir.actions.act_window">
    <field name="name">Custom Currency</field>
    <field name="res_model">custom_currency</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_custom_currency_rates" model="ir.actions.act_window">
    <field name="name">Custom Currency Rates</field>
    <field name="res_model">custom_currency</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="view_custom_currency_form" model="ir.ui.view">
    <field name="name">Default form view for custom_currency</field>
    <field name="model">custom_currency</field>
    <field name="key">studio_customization.default_form_view_fo_8a4b6def-7c88-4ab2-9f17-96bd901a9f4e</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Custom Currency">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
          <field name="active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_6e4bb6">
            <group name="studio_group_6e4bb6_left"/>
            <group name="studio_group_6e4bb6_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="view_custom_currency_list" model="ir.ui.view">
    <field name="name">Default list view for custom_currency</field>
    <field name="model">custom_currency</field>
    <field name="key">studio_customization.default_list_view_fo_c10f81e8-0461-45dc-bca4-c7824d05528e</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_custom_currency_search" model="ir.ui.view">
    <field name="name">Default search view for custom_currency</field>
    <field name="model">custom_currency</field>
    <field name="key">studio_customization.default_search_view__a298038c-e955-424c-892e-bd176971bcc1</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <separator/>
        <filter string="Archived" name="archived_custom_currency" domain="[['active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
    <record id="view_custom_currency_search_2" model="ir.ui.view">
        <field name="name">Default search view for custom_currency</field>
        <field name="model">custom_currency</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_custom_currency" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_default_form_view_for_custom_currency_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default form view for custom_currency customization</field>
        <field name="model">custom_currency</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_custom_currency_form"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//widget[@name='web_ribbon']" position="before">
                <div name="button_box" class="oe_button_box">
                  <button class="oe_stat_button" type="action" name="%(BugFix-Accounting.act_custom_currency_rates)d" icon="fa-money" invisible="accounting_active == False">
                    <field widget="statinfo" name="custom_currency_id__x_custom_currency_rate_count" string="Rates"/>
                  </button>
                </div>
              </xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute><attribute name="required"/></xpath>
              <xpath expr="//group[@name='studio_group_6e4bb6_left']" position="inside">
                <field name="accounting_currency_id" force_save="True" required="1" options="{&quot;no_create&quot;:true}"/>
                <field name="accounting_name" string="Name"/>
                <field name="iso_currency_code" string="ISO Currency Code"/>
              </xpath>
              <xpath expr="//group[@name='studio_group_6e4bb6_right']" position="inside">
                <field name="currency_unit" string="Currency Unit"/>
                <field name="symbol" string="Symbol"/>
                <field name="current_rate" string="Current Rate" invisible="1"/>
                <field name="date" string="Date" invisible="1"/>
                <field name="accounting_active" string="Active" widget="boolean_toggle"/>
                <field name="accounting_company_id" string="Company" force_save="True" readonly="1"/>
              </xpath>
            </data>
        </field>
    </record>
    <record id="view_default_list_view_for_custom_currency_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for custom_currency customization</field>
        <field name="model">custom_currency</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_custom_currency_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='sequence']" position="before">
                <field name="accounting_currency_id"/>
                <field name="accounting_name"/>
                <field name="iso_currency_code"/>
                <field name="symbol"/>
                <field name="date" column_invisible="1"/>
                <field name="current_rate" column_invisible="1"/>
                <field name="accounting_active" widget="boolean_toggle"/>
                <xpath expr="//field[@name='name']" position="move"/>
              </xpath>
              <xpath expr="//field[@name='sequence']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
            </data>
        </field>
    </record>
</odoo>

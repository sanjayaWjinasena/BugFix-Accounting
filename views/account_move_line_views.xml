    <record id="view_account_move_line_form_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: account.move.line.form customization</field>
        <field name="model">account.move.line</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='move_id']" position="after">
                <field name="many2one_field_kiSUJ"/>
                <field name="sales_report_type" string="Report Type (S- Incentive Calculation)"/>
                <field name="price_unit"/>
                <field name="price_subtotal"/>
                <field name="price_total"/>
                <field name="account_internal_group"/>
                <field name="display_type"/>
                <field name="status"/>
              </xpath>
            </data>
        </field>
    </record>
    <record id="view_account_move_line_tree_etf_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: account.move.line.tree-ETF customization</field>
        <field name="model">account.move.line</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <!-- v0.0.19: inherit_id points at our own ported primary above -->
        <field name="inherit_id" ref="BugFix-Accounting.view_account_move_line_tree_etf"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='move_name']" position="replace"/>
              <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="column_invisible">True</attribute>
              </xpath>
              <xpath expr="//field[@name='date']" position="after">
                <field optional="show" name="surname"/>
                <field optional="show" name="initials"/>
                <field optional="show" name="nic_number"/>
                <field optional="show" name="etf_number"/>
                <field optional="hide" name="contract_id" readonly="True" column_invisible="True"/>
              </xpath>
              <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
              </xpath>
              <xpath expr="//field[@name='account_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
              </xpath>
              <xpath expr="//tree[1]/field[@name='partner_id']" position="attributes">
                <attribute name="optional">hide</attribute>
              </xpath>
              <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
              </xpath>
              <xpath expr="//tree[1]/field[@name='name']" position="attributes">
                <attribute name="column_invisible">True</attribute>
              </xpath>
              <xpath expr="//field[@name='tax_ids']" position="attributes">
                <attribute name="column_invisible">True</attribute>
              </xpath>
              <xpath expr="//field[@name='amount_currency']" position="attributes">
                <attribute name="column_invisible">True</attribute>
                <attribute name="invisible">False</attribute>
                <attribute name="string">Contribution</attribute>
              </xpath>
              <xpath expr="//field[@name='amount_currency']" position="after">
                <field optional="show" name="employers_contribution" readonly="True" column_invisible="True"/>
                <field optional="show" name="members_contribution" readonly="True" column_invisible="True"/>
                <field optional="show" name="total_contribution" readonly="True" column_invisible="True"/>
              </xpath>
              <xpath expr="//field[@name='debit']" position="attributes">
                <attribute name="column_invisible">True</attribute>

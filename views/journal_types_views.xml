<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_journal_types" model="ir.actions.act_window">
    <field name="name">Journal Types</field>
    <field name="res_model">journal_types</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_journal_types_form" model="ir.ui.view">
        <field name="name">Default form view for journal_types</field>
        <field name="model">journal_types</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="Journal Types">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                <field name="active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_3545bc">
                  <group name="studio_group_3545bc_left"/>
                  <group name="studio_group_3545bc_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="view_journal_types_search" model="ir.ui.view">
        <field name="name">Default search view for journal_types</field>
        <field name="model">journal_types</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_journal_types" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_journal_types_list" model="ir.ui.view">
        <field name="name">Default list view for journal_types</field>
        <field name="model">journal_types</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_default_list_view_for_journal_types_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for journal_types customization</field>
        <field name="model">journal_types</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_journal_types_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//tree[1]" position="attributes">
                <attribute name="editable">bottom</attribute>
              </xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Journal Type</attribute>
              </xpath>
              <xpath expr="//field[@name='name']" position="after">
                <field optional="show" name="description" string="Description"/>
                <field optional="show" name="offset_account" string="Offset Account"/>
                <field optional="show" name="accounting_company_id" string="Company" readonly="1"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>

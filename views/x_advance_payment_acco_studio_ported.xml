<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_c97b1ccb_8539_4035_a437_f09e7ab96775" model="ir.ui.view">
    <field name="name">Default form view for x_advance_payment_acco</field>
    <field name="model">x_advance_payment_acco</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Advance Payment Account">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_9ff9b8">
            <group name="studio_group_9ff9b8_left"/>
            <group name="studio_group_9ff9b8_right"/>
          </group>
        </sheet>
        <div class="oe_chatter" name="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="message_ids"/>
          <field name="activity_ids"/>
        </div>
      </form>
    </field>
  </record>
  <record id="ported_odoo_studio_default__d44ef857_6f61_4cce_b760_cde110a7cae9" model="ir.ui.view">
    <field name="name">Odoo Studio: Default form view for x_advance_payment_acco customization</field>
    <field name="model">x_advance_payment_acco</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="BugFix-Accounting.ported_default_form_view_fo_c97b1ccb_8539_4035_a437_f09e7ab96775"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//group[@name='studio_group_9ff9b8_left']" position="attributes">
          <attribute name="string">Advance Payment Accounts</attribute>
        </xpath>
        <xpath expr="//group[@name='studio_group_9ff9b8_left']" position="inside">
          <field name="x_studio_advance_payment_account_sales" string="Advance Payment Account (Sales)"/>
          <field name="x_studio_advance_payment_account_purchases_1" string="Advance Payment Account (Purchases)"/>
        </xpath>
        <xpath expr="//group[@name='studio_group_9ff9b8_right']" position="attributes">
          <attribute name="string">Advance Accounts</attribute>
        </xpath>
        <xpath expr="//group[@name='studio_group_9ff9b8_right']" position="inside">
          <field name="x_studio_advance_account_project" string="Advance Account (Project)"/>
        </xpath>
      </data>
    </field>
  </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_consignment_charge_header" model="ir.actions.act_window">
    <field name="name">Consignment Charge Header</field>
    <field name="res_model">consignment_charge_h</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_header_charges" model="ir.actions.act_window">
    <field name="name">Header Charges</field>
    <field name="res_model">consignment_charge_h</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('consignment_id', '=', active_id)]</field>
    <field name="context">{'search_default_consignment_id': active_id,'default_consignment_id': active_id,'group_by': 'charge_group'}</field>
  </record>
  <record id="action_consignment_charge_header_2" model="ir.actions.act_window">
    <field name="name">Consignment Charge Header</field>
    <field name="res_model">consignment_charge_h</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_consignment_charge_header_3" model="ir.actions.act_window">
    <field name="name">Consignment Charge Header</field>
    <field name="res_model">consignment_charge_h</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_purchase_invoices" model="ir.actions.act_window">
    <field name="name">Purchase Invoices</field>
    <field name="res_model">consignment_charge_h</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_consignment_charge_h_form" model="ir.ui.view">
        <field name="name">Default form view for consignment_charge_h</field>
        <field name="model">consignment_charge_h</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="Consignment Charge Header">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                <field name="active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_99a601">
                  <group name="studio_group_99a601_left"/>
                  <group name="studio_group_99a601_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="view_consignment_charge_h_search" model="ir.ui.view">
        <field name="name">Default search view for consignment_charge_h</field>
        <field name="model">consignment_charge_h</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_consignment_charge_h" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_consignment_charge_h_list" model="ir.ui.view">
        <field name="name">Default list view for consignment_charge_h</field>
        <field name="model">consignment_charge_h</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_default_form_view_for_consignment_charge_h_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default form view for consignment_charge_h customization</field>
        <field name="model">consignment_charge_h</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_consignment_charge_h_form"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//group[@name='studio_group_99a601_left']" position="inside">
                <field name="charge_group" string="Charge Group"/>
                <field name="charge_name" string="Charge Name"/>
                <field name="basis" string="Basis" invisible="1"/>
                <field name="formula" string="Formula" invisible="1"/>
                <field name="amount" string="Amount"/>
                <field name="ledger_post" string="Ledger Post"/>
              </xpath>
              <xpath expr="//group[@name='studio_group_99a601_right']" position="inside">
                <field name="consignment_id" string="Consignment Id" invisible="1"/>
                <!-- v143: structure_details_line_ids / structure_master_id moved to BugFix-Purchase (upstream_link_fields_views.xml) -->
                <field name="structure_no" string="Structure No" invisible="1"/>
                <field name="tax_appicable" string="Tax Appicable" invisible="1"/>
              </xpath>
            </data>
        </field>
    </record>
    <record id="view_default_list_view_for_consignment_charge_h_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for consignment_charge_h customization</field>
        <field name="model">consignment_charge_h</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_consignment_charge_h_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//tree[1]" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="delete">false</attribute>
                <attribute name="editable">bottom</attribute>
              </xpath>
              <xpath expr="//field[@name='sequence']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
              <xpath expr="//field[@name='sequence']" position="after">
                <field name="charge_group" readonly="1"/>
                <field name="charge_name" readonly="1"/>
                <field name="amount" readonly="(allocate_header_charges == True) or (charge_group != 'Charges')"/>
                <field name="ledger_post" widget="boolean" readonly="allocate_header_charges == True"/>
                <field optional="show" name="accounting_company_id" string="Company" column_invisible="1"/>
                <field name="tax_appicable" string="Tax Applicable" column_invisible="1"/>
                <field name="tax_appicable2" string="Tax Applicable2" column_invisible="1"/>
                <field name="tp_processed" string="TP Processed" column_invisible="1"/>
                <field name="allocate_header_charges" string="Allocate Header Charges" column_invisible="1"/>
              </xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
            </data>
        </field>
    </record>
</odoo>

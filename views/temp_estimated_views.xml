<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_temp_estimated" model="ir.actions.act_window">
    <field name="name">Temp_Estimated</field>
    <field name="res_model">temp_estimated</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_temp_estimated_form" model="ir.ui.view">
        <field name="name">Default form view for temp_estimated</field>
        <field name="model">temp_estimated</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="Temp_Estimated">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                <field name="active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_bf870f">
                  <group name="studio_group_bf870f_left"/>
                  <group name="studio_group_bf870f_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="view_temp_estimated_search" model="ir.ui.view">
        <field name="name">Default search view for temp_estimated</field>
        <field name="model">temp_estimated</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_temp_estimated" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_temp_estimated_list" model="ir.ui.view">
        <field name="name">Default list view for temp_estimated</field>
        <field name="model">temp_estimated</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_default_list_view_for_temp_estimated_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for temp_estimated customization</field>
        <field name="model">temp_estimated</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_temp_estimated_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
              <xpath expr="//field[@name='name']" position="after">
                <field optional="show" name="estimated_line_ids" string="Estimated Line Ids" column_invisible="1"/>
                <field optional="show" name="actual_line_ids" string="Actual Line Ids" column_invisible="1"/>
                <field optional="show" name="sales_order" string="Sales Order"/>
                <field optional="show" name="customer" string="Customer"/>
                <field optional="show" name="sales_order_line_id" string="Sales Order Line Id" column_invisible="1"/>
                <field optional="show" name="product_id" string="Product Id"/>
                <field optional="show" name="description" string="Description"/>
                <field optional="show" name="trans_type" string="Trans Type"/>
                <field optional="show" name="category" string="Category"/>
                <field optional="show" name="quantity" string="Quantity"/>
                <field optional="show" name="delivered_qty" string="Delivered Qty"/>
                <field optional="show" name="uom" string="UOM"/>
                <field optional="show" name="unit_price" string="Unit Price"/>
                <field optional="show" name="sub_total" string="Sub Total"/>
                <field optional="show" name="project_no" string="Project No" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>

          <group name="studio_group_e8c751">
            <group name="studio_group_e8c751_left"/>
            <group name="studio_group_e8c751_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="ported_default_list_view_fo_ca009934_0cbf_4bef_b9a5_cc7156daa1a9" model="ir.ui.view">

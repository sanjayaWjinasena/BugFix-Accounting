<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_slow_moving_items" model="ir.actions.act_window">
    <field name="name">Slow Moving Items</field>
    <field name="res_model">rm_none_moving</field>
    <field name="view_mode">pivot</field>
  </record>
  <record id="action_slow_moving_items_2" model="ir.actions.act_window">
    <field name="name">Slow Moving Items</field>
    <field name="res_model">rm_none_moving</field>
    <field name="view_mode">pivot</field>
  </record>
    <record id="view_rm_none_moving_form" model="ir.ui.view">
        <field name="name">Default form view for rm_none_moving</field>
        <field name="model">rm_none_moving</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="RM None Moving">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                <field name="active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_2f7829">
                  <group name="studio_group_2f7829_left"/>
                  <group name="studio_group_2f7829_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="view_rm_none_moving_search" model="ir.ui.view">
        <field name="name">Default search view for rm_none_moving</field>
        <field name="model">rm_none_moving</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_rm_none_moving" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_rm_none_moving_list" model="ir.ui.view">
        <field name="name">Default list view for rm_none_moving</field>
        <field name="model">rm_none_moving</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_default_list_view_for_rm_none_moving_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for rm_none_moving customization</field>
        <field name="model">rm_none_moving</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_rm_none_moving_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//tree[1]" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="delete">true</attribute>
                <attribute name="edit">false</attribute>
              </xpath>
              <xpath expr="//field[@name='sequence']" position="after">
                <field name="sales_report_model_id" string="Sales Report Model Id" column_invisible="1"/>
                <field name="product_code_1" string="Product Code"/>
                <field name="product_category" string="Product Category"/>
                <field name="description" string="Description"/>
                <field name="base_price" string="Base Price"/>
                <field name="in_hand_1" string="In Hand"/>
                <field name="issue_1" string="Issue"/>
                <field name="in_hand_2" string="In Hand"/>
                <field name="issue_2" string="Issue"/>
                <field name="in_hand_3" string="In Hand"/>
                <field name="issue_3" string="Issue"/>
                <field name="in_hand_4" string="In Hand"/>
                <field name="issue_4" string="Issue"/>
                <field name="qty" string="Qty"/>
                <field name="value" string="Value"/>
                <field name="header_reference" string="Header Reference"/>
              </xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
            </data>
        </field>
    </record>
</odoo>

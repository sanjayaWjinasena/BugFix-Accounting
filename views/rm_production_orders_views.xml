<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_wip_production_orders" model="ir.actions.act_window">
    <field name="name">WIP Production Orders</field>
    <field name="res_model">rm_production_orders</field>
    <field name="view_mode">pivot</field>
  </record>
  <record id="action_pivot_views" model="ir.actions.act_window">
    <field name="name">Pivot Views</field>
    <field name="res_model">rm_production_orders</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_rm_production_orders_form" model="ir.ui.view">
        <field name="name">Default form view for rm_production_orders</field>
        <field name="model">rm_production_orders</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="RM Production Orders">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                <field name="active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_5c843d">
                  <group name="studio_group_5c843d_left"/>
                  <group name="studio_group_5c843d_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="view_rm_production_orders_search" model="ir.ui.view">
        <field name="name">Default search view for rm_production_orders</field>
        <field name="model">rm_production_orders</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_rm_production_orders" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_rm_production_orders_list" model="ir.ui.view">
        <field name="name">Default list view for rm_production_orders</field>
        <field name="model">rm_production_orders</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_default_list_view_for_rm_production_orders_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for rm_production_orders customization</field>
        <field name="model">rm_production_orders</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_rm_production_orders_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='name']" position="replace">
                <field name="header_reference" string="Header Reference" column_invisible="1"/>
                <field name="production_id" string="Production Id"/>
                <field name="product_code" string="Product Code"/>
                <field name="description" string="Description"/>
                <field name="warehouse" string="Warehouse"/>
                <field name="status" string="Status"/>
                <field name="estimated" string="Estimated"/>
                <field name="started" string="Started"/>
                <field name="good_qty" string="Good Qty"/>
                <field name="start" string="Start" widget="date"/>
                <field name="accounting_end" string="End" widget="date"/>
                <field name="sales_report_model_id" string="Sales Report Model Id" column_invisible="1"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>

  </record>
  <record id="view_rm_gross_margin_actu_list" model="ir.ui.view">
    <field name="name">Default list view for rm_gross_margin_actu</field>
    <field name="model">rm_gross_margin_actu</field>
    <field name="key">studio_customization.default_list_view_fo_ff791a31-7daf-408c-acdc-7018fc44fd67</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_rm_gross_margin_actu_search" model="ir.ui.view">
    <field name="name">Default search view for rm_gross_margin_actu</field>
    <field name="model">rm_gross_margin_actu</field>
    <field name="key">studio_customization.default_search_view__5d9028dc-d96e-4d44-a869-146eb1842773</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <separator/>
        <filter string="Archived" name="archived_rm_gross_margin_actu" domain="[['active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
  <record id="view_default_list_view_for_rm_gross_margin_actu_inherit" model="ir.ui.view">
    <field name="name">Odoo Studio: Default list view for rm_gross_margin_actu customization</field>
    <field name="model">rm_gross_margin_actu</field>
    <field name="key">studio_customization.odoo_studio_default__fc4b2707-e1d3-4e84-9239-9cbf0d789b47</field>
    <field name="type">tree</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="BugFix-Accounting.view_rm_gross_margin_actu_list"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//tree[1]" position="attributes">
          <attribute name="editable">bottom</attribute>
        </xpath>
        
        
        
        
      </data>
    </field>
  </record>
    <record id="view_rm_gross_margin_actu_search_2" model="ir.ui.view">
        <field name="name">Default search view for rm_gross_margin_actu</field>
        <field name="model">rm_gross_margin_actu</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_rm_gross_margin_actu" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_default_list_view_for_rm_gross_margin_actu_inherit_2" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for rm_gross_margin_actu customization</field>
        <field name="model">rm_gross_margin_actu</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_rm_gross_margin_actu_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//tree[1]" position="attributes">
                <attribute name="editable">bottom</attribute>
              </xpath>
              <xpath expr="//field[@name='sequence']" position="before">
                <field optional="show" name="transaction_type_1" string="Transaction Type"/>
                <field optional="show" name="other_expenses" string="Other Expenses"/>
                <field optional="show" name="estimated_total" string="Estimated Total"/>
                <field optional="show" name="cost_price" string="Cost Price"/>
                <field optional="show" name="variance_est_act" string="Variance (Est - Act)"/>
              </xpath>
              <xpath expr="//field[@name='sequence']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
              <xpath expr="//field[@name='name']" position="after">
                <field optional="show" name="sales_report_model_id" string="Sales Report Model Id" column_invisible="1"/>
                <field optional="show" name="header_reference" string="Header Reference" column_invisible="1"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>

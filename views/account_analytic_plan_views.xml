<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_account_analytic_plan" model="ir.actions.act_window">
    <field name="name"> account.analytic.plan</field>
    <field name="res_model">account.analytic.plan</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_account_analytic_plan_2" model="ir.actions.act_window">
    <field name="name"> account.analytic.plan</field>
    <field name="res_model">account.analytic.plan</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_account_analytic_group_form_inherit" model="ir.ui.view">
      <field name="name">Odoo Studio: account.analytic.group.form customization</field>
      <field name="model">account.analytic.plan</field>
      <field name="type">form</field>
      <field name="priority">99</field>
      <field name="active" eval="False"/>
      <field name="inherit_id" ref="analytic.account_analytic_plan_form_view"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//form[1]/sheet[1]/group[1]" position="before">
    <div name="button_box" class="oe_button_box">
      <button class="oe_stat_button" icon="fa-diamond" type="action" name="%(BugFix-Accounting.action_analytic_account)d">
        <field widget="statinfo" name="group_id_account_analytic_account_count" string="Analytic Account"/>
      </button>
      <button class="oe_stat_button" icon="fa-diamond" type="action" name="%(BugFix-Accounting.action_analytic_line_2)d">
        <field widget="statinfo" name="group_id_account_analytic_line_count" string="Analytic Line"/>
      </button>
    </div>
  </xpath>
</data>
      </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_tp_invoice_line" model="ir.actions.act_window">
    <field name="name">TP Invoice Line</field>
    <field name="res_model">tp_invoice_line</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_tp_invoice_line_2" model="ir.actions.act_window">
    <field name="name">TP Invoice Line</field>
    <field name="res_model">tp_invoice_line</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_tp_invoice_line_form" model="ir.ui.view">
        <field name="name">Default form view for tp_invoice_line</field>
        <field name="model">tp_invoice_line</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="TP Invoice Line">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                <field name="active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_6de1a3">
                  <group name="studio_group_6de1a3_left"/>
                  <group name="studio_group_6de1a3_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="view_tp_invoice_line_search" model="ir.ui.view">
        <field name="name">Default search view for tp_invoice_line</field>
        <field name="model">tp_invoice_line</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_tp_invoice_line" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_tp_invoice_line_list" model="ir.ui.view">
        <field name="name">Default list view for tp_invoice_line</field>
        <field name="model">tp_invoice_line</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_default_form_view_for_tp_invoice_line_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default form view for tp_invoice_line customization</field>
        <field name="model">tp_invoice_line</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_tp_invoice_line_form"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute><attribute name="required"/></xpath>
              <xpath expr="//group[@name='studio_group_6de1a3_left']" position="inside">
                <field name="charge_group" string="Charge Group" force_save="True" readonly="1"/>
                <field name="charge_name" string="Charge Name" force_save="True" readonly="1"/>
                <field name="original_amount" string="Original Amount" force_save="True" readonly="1"/>
                <field name="invoice_amount" string="Invoice Amount"/>
                <field name="basis" string="Basis" force_save="True" readonly="1" invisible="1"/>
                <field name="consignment_id" string="Consignment Id" force_save="True" readonly="1" invisible="1"/>
                <field name="consignment_charge_header_id" string="Consignment Charge Header Id" force_save="True" readonly="1" invisible="1"/>
                <field name="tp_invoice_header_id" string="TP Invoice Header Id" force_save="True" readonly="1" invisible="1"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>

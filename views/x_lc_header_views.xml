  <record id="ported_default_form_view_fo_0505f2ad_156e_4774_9f56_2c28078f71bc" model="ir.ui.view">
    <field name="name">Default form view for x_lc_header</field>
    <field name="model">x_lc_header</field>
    <field name="key">studio_customization.default_form_view_fo_0505f2ad-156e-4774-9f56-2c28078f71bc</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <!-- Restored in v0.0.26: auto-porter had stripped these two buttons
               when it fetched the arch. Referenced from the v2 extension's
               xpath anchor //button[@string='Post LC'] (line 45 of _v2 file).
               Actions ported in data/server_actions_v2.xml (srv_lc_post_lc /
               srv_lc_amend_lc). -->
          <button type="action" name="%(BugFix-Accounting.srv_lc_post_lc)d" string="Post LC" class="btn-primary" invisible="x_studio_status not in ['Draft']"/>
          <button type="action" name="%(BugFix-Accounting.srv_lc_amend_lc)d" string="Amend LC" class="btn-primary" invisible="x_studio_status not in ['Posted']"/>
        </header>
        <header/>
        <sheet string="LC Header">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <!-- v0.0.27: sentinel field to satisfy validator. The header
               buttons above reference x_studio_status in their invisible
               modifiers; the extension view (3063) declares x_studio_status
               visibly, but Odoo validates the primary view standalone
               before extensions merge on fresh install, so the field must
               exist in the primary arch. Invisible = zero UI impact. -->
          <field name="x_studio_status" invisible="1"/>
          <div class="oe_title">
                      <span class="o_form_label">Registration No </span>
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_535d1b">
            <group name="studio_group_535d1b_left"/>
            <group name="studio_group_535d1b_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>

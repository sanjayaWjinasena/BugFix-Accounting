<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_customer_posting_profile" model="ir.actions.act_window">
    <field name="name">Customer Posting Profile</field>
    <field name="res_model">customer_posting_pro</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_customer_posting_pro" model="ir.actions.act_window">
    <field name="name">customer_posting_pro</field>
    <field name="res_model">customer_posting_pro</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="view_customer_posting_pro_form" model="ir.ui.view">
    <field name="name">Default form view for customer_posting_pro</field>
    <field name="model">customer_posting_pro</field>
    <field name="key">studio_customization.default_form_view_fo_f49a8f85-9bb2-43ef-8f4f-8b962b411265</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Customer Posting Profile">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
          <field name="active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_6195ed">
            <group name="studio_group_6195ed_left"/>
            <group name="studio_group_6195ed_right"/>
          </group>
          <group>
            <field name="notes" placeholder="Type down your notes here..." nolabel="1"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="view_customer_posting_pro_list" model="ir.ui.view">
    <field name="name">Default list view for customer_posting_pro</field>
    <field name="model">customer_posting_pro</field>
    <field name="key">studio_customization.default_list_view_fo_3031fe1e-398f-4098-9918-014ea6ba462f</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_customer_posting_pro_search" model="ir.ui.view">
    <field name="name">Default search view for customer_posting_pro</field>
    <field name="model">customer_posting_pro</field>
    <field name="key">studio_customization.default_search_view__75c14789-fbd8-4c3b-9714-053aebf3de17</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <separator/>
        <filter string="Archived" name="archived_customer_posting_pro" domain="[['active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
    <record id="view_customer_posting_pro_search_2" model="ir.ui.view">
        <field name="name">Default search view for customer_posting_pro</field>
        <field name="model">customer_posting_pro</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_customer_posting_pro" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_default_form_view_for_customer_posting_pro_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default form view for customer_posting_pro customization</field>
        <field name="model">customer_posting_pro</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_customer_posting_pro_form"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//form[1]/sheet[1]/div[1]/h1[1]" position="replace"/>
              <xpath expr="//group[@name='studio_group_6195ed_left']" position="inside">
                <field name="item_relation_type" string="Item Relation Type"/>
              </xpath>
            </data>
        </field>
    </record>
    <record id="view_default_list_view_for_customer_posting_pro_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for customer_posting_pro customization</field>
        <field name="model">customer_posting_pro</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_customer_posting_pro_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='name']" position="replace"/>
              <xpath expr="//field[@name='sequence']" position="replace"/>
            </data>
        </field>
    </record>
</odoo>

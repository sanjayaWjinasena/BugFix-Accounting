<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_1679_rm_daily_s3" model="ir.actions.act_window">
    <field name="name">RM Daily S3</field>
    <field name="res_model">x_rm_daily_s3</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="ported_view_3810_default_form_view_fo_a5dfdae0_6aa5_4ccc_9466_84fde1363927" model="ir.ui.view">
        <field name="name">Default form view for x_rm_daily_s3</field>
        <field name="model">x_rm_daily_s3</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="RM Daily S3">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
                <field name="x_active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="x_name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_2c1b48">
                  <group name="studio_group_2c1b48_left"/>
                  <group name="studio_group_2c1b48_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="ported_view_3811_default_search_view_caa9a3e6_5a95_452d_b66f_aeaa32017275" model="ir.ui.view">
        <field name="name">Default search view for x_rm_daily_s3</field>
        <field name="model">x_rm_daily_s3</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="x_name"/>
              <separator/>
              <filter string="Archived" name="archived_x_rm_daily_s3" domain="[['x_active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="ported_view_3809_default_list_view_fo_bb0154ee_5685_4655_a271_a89ac8597200" model="ir.ui.view">
        <field name="name">Default list view for x_rm_daily_s3</field>
        <field name="model">x_rm_daily_s3</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="x_studio_sequence" widget="handle"/>
              <field name="x_name"/>
            </tree>
        </field>
    </record>
    <record id="ported_view_3814_odoo_studio_default_bbdb4d27_c755_4b18_a675_1142c0001aa0" model="ir.ui.view">
        <field name="name">Odoo Studio: Default form view for x_rm_daily_s3 customization</field>
        <field name="model">x_rm_daily_s3</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.ported_view_3810_default_form_view_fo_a5dfdae0_6aa5_4ccc_9466_84fde1363927"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//group[@name='studio_group_2c1b48_left']" position="inside">
                <field name="x_studio_sales_report_model_id" string="Sales Report Model Id" invisible="1"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_temp_actual_budget" model="ir.actions.act_window">
    <field name="name">Temp_Actual_Budget</field>
    <field name="res_model">temp_actual_budget</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="view_temp_actual_budget_form" model="ir.ui.view">
    <field name="name">Default form view for temp_actual_budget</field>
    <field name="model">temp_actual_budget</field>
    <field name="key">studio_customization.default_form_view_fo_741643ee-ca4d-4aa5-a8e3-76dfefa6c8c1</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Temp_Actual_Budget">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
          <field name="active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_2e9832">
            <group name="studio_group_2e9832_left"/>
            <group name="studio_group_2e9832_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="view_temp_actual_budget_list" model="ir.ui.view">
    <field name="name">Default list view for temp_actual_budget</field>
    <field name="model">temp_actual_budget</field>
    <field name="key">studio_customization.default_list_view_fo_bcc5f161-0ade-4995-9c51-35002b4f9d4d</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_temp_actual_budget_search" model="ir.ui.view">
    <field name="name">Default search view for temp_actual_budget</field>
    <field name="model">temp_actual_budget</field>
    <field name="key">studio_customization.default_search_view__65bb7bb5-0341-4946-8b0e-8040521503cf</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <separator/>
        <filter string="Archived" name="archived_temp_actual_budget" domain="[['active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
    <record id="view_temp_actual_budget_search_2" model="ir.ui.view">
        <field name="name">Default search view for temp_actual_budget</field>
        <field name="model">temp_actual_budget</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_temp_actual_budget" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_default_list_view_for_temp_actual_budget_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for temp_actual_budget customization</field>
        <field name="model">temp_actual_budget</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_temp_actual_budget_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='sequence']" position="after">
                <field optional="show" name="budget_line_ids" string="Budget Line Ids" column_invisible="1"/>
                <field optional="show" name="crossovered_budget_id" widget="product_configurator"/>
                <field optional="show" name="analytic_account_id"/>
                <field optional="show" name="date_from" string="Start Date"/>
                <field optional="show" name="date_to" string="End Date"/>
                <field optional="show" name="planned_amount" string="Planned Amount"/>
                <field name="currency_id" column_invisible="1"/>
              </xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
              <xpath expr="//field[@name='name']" position="after">
                <field optional="show" name="actual_line_ids" string="Actual Line Ids" column_invisible="1"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>

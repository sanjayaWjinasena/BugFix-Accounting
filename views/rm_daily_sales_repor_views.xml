<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_rm_daily_sales_report" model="ir.actions.act_window">
    <field name="name">RM Daily Sales Report</field>
    <field name="res_model">rm_daily_sales_repor</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_rm_daily_sales_repor_form" model="ir.ui.view">
        <field name="name">Default form view for rm_daily_sales_repor</field>
        <field name="model">rm_daily_sales_repor</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="RM Daily Sales Report">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                <field name="active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_0e0847">
                  <group name="studio_group_0e0847_left"/>
                  <group name="studio_group_0e0847_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="view_rm_daily_sales_repor_search" model="ir.ui.view">
        <field name="name">Default search view for rm_daily_sales_repor</field>
        <field name="model">rm_daily_sales_repor</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_rm_daily_sales_repor" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_rm_daily_sales_repor_list" model="ir.ui.view">
        <field name="name">Default list view for rm_daily_sales_repor</field>
        <field name="model">rm_daily_sales_repor</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_default_form_view_for_rm_daily_sales_repor_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default form view for rm_daily_sales_repor customization</field>
        <field name="model">rm_daily_sales_repor</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_rm_daily_sales_repor_form"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//group[@name='studio_group_0e0847_left']" position="inside">
                <field name="sales_report_model_id" string="Sales Report Model Id" force_save="True" readonly="1" invisible="1"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_rm_gross_margin_invoice_details" model="ir.actions.act_window">
    <field name="name">RM Gross Margin - Invoice Details</field>
    <field name="res_model">rm_gross_margin_invo</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_rm_gross_margin_invo_form" model="ir.ui.view">
        <field name="name">Default form view for rm_gross_margin_invo</field>
        <field name="model">rm_gross_margin_invo</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="RM Gross Margin - Invoice Details">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                <field name="active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_8bebb6">
                  <group name="studio_group_8bebb6_left"/>
                  <group name="studio_group_8bebb6_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="view_rm_gross_margin_invo_search" model="ir.ui.view">
        <field name="name">Default search view for rm_gross_margin_invo</field>
        <field name="model">rm_gross_margin_invo</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_rm_gross_margin_invo" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_rm_gross_margin_invo_list" model="ir.ui.view">
        <field name="name">Default list view for rm_gross_margin_invo</field>
        <field name="model">rm_gross_margin_invo</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_default_list_view_for_rm_gross_margin_invo_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for rm_gross_margin_invo customization</field>
        <field name="model">rm_gross_margin_invo</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_rm_gross_margin_invo_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//tree[1]" position="attributes">
                <attribute name="editable">bottom</attribute>
              </xpath>
              <xpath expr="//field[@name='sequence']" position="after">
                <field optional="show" name="sales_report_model_id" string="Sales Report Model Id" column_invisible="1"/>
                <field optional="show" name="header_reference" string="Header Reference" column_invisible="1"/>
                <field optional="show" name="status" string="Status"/>
                <field optional="show" name="accounting_invoice_date" string="Invoice Date"/>
                <field optional="show" name="invoice_status" string="Invoice Status"/>
                <field optional="show" name="amount" string="Amount"/>
              </xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
            </data>
        </field>
    </record>
</odoo>

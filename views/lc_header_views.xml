  <record id="view_lc_header_form" model="ir.ui.view">
    <field name="name">Default form view for lc_header</field>
    <field name="model">lc_header</field>
    <field name="key">studio_customization.default_form_view_fo_0505f2ad-156e-4774-9f56-2c28078f71bc</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <!-- Restored in v0.0.26: auto-porter had stripped these two buttons
               when it fetched the arch. Referenced from the v2 extension's
               xpath anchor //button[@string='Post LC'] (line 45 of _v2 file).
               Actions ported in data/server_actions_v2.xml (srv_lc_post_lc /
               srv_lc_amend_lc). -->
          <button type="action" name="%(BugFix-Accounting.srv_lc_post_lc)d" string="Post LC" class="btn-primary" invisible="status not in ['Draft']"/>
          <button type="action" name="%(BugFix-Accounting.srv_lc_amend_lc)d" string="Amend LC" class="btn-primary" invisible="status not in ['Posted']"/>
        </header>
        <header/>
        <sheet string="LC Header">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
          <field name="active" invisible="1"/>
          <!-- v0.0.27: sentinel field to satisfy validator. The header
               buttons above reference status in their invisible
               modifiers; the extension view (3063) declares status
               visibly, but Odoo validates the primary view standalone
               before extensions merge on fresh install, so the field must
               exist in the primary arch. Invisible = zero UI impact. -->
          <field name="status" invisible="1"/>
          <div class="oe_title">
                      <span class="o_form_label">Registration No </span>
                      <h1>
                          <field name="name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_535d1b">
            <group name="studio_group_535d1b_left"/>
            <group name="studio_group_535d1b_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="view_lc_header_list" model="ir.ui.view">
    <field name="name">Default list view for lc_header</field>
    <field name="model">lc_header</field>
    <field name="key">studio_customization.default_list_view_fo_a916dec6-fd01-439b-b5cc-5936bca48af2</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_lc_header_search" model="ir.ui.view">
    <field name="name">Default search view for lc_header</field>
    <field name="model">lc_header</field>
    <field name="key">studio_customization.default_search_view__b401215c-a31a-436a-8006-25d5733275fa</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <separator/>
        <filter string="Archived" name="archived_lc_header" domain="[['active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
  <record id="view_default_form_view_for_lc_header_inherit" model="ir.ui.view">
    <field name="name">Odoo Studio: Default form view for lc_header customization</field>
    <field name="model">lc_header</field>
    <field name="key">studio_customization.odoo_studio_default__20735bbc-d408-4d7a-8c04-a3bf6b3dfcd9</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="BugFix-Accounting.view_lc_header_form"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//form[1]" position="attributes">
          <attribute name="create">false</attribute>
          <attribute name="delete">false</attribute>
        </xpath>
        
        
        
        
      </data>
    </field>
  </record>
  <record id="view_default_list_view_for_lc_header_inherit" model="ir.ui.view">
    <field name="name">Odoo Studio: Default list view for lc_header customization</field>
    <field name="model">lc_header</field>
    <field name="key">studio_customization.odoo_studio_default__a61f262f-36fb-4249-a2be-011d2c858898</field>
    <field name="type">tree</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="BugFix-Accounting.view_lc_header_list"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//tree[1]" position="attributes">
          <attribute name="create">false</attribute>
          <attribute name="default_order">name desc</attribute>
          <attribute name="delete">false</attribute>
          <attribute name="edit">false</attribute>

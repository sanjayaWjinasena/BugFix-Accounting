  </record>
    <record id="view_lc_header_search_2" model="ir.ui.view">
        <field name="name">Default search view for lc_header</field>
        <field name="model">lc_header</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_lc_header" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_default_form_view_for_lc_header_inherit_2" model="ir.ui.view">
        <field name="name">Odoo Studio: Default form view for lc_header customization</field>
        <field name="model">lc_header</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_lc_header_form"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//form[1]" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="delete">false</attribute>
              </xpath>
              <!-- v0.0.27: anchor was `//button[@name='1404']` on Clear-DB,
                   but numeric action ids don't survive fresh install. Odoo
                   also disallows @string as a view-inheritance selector, so
                   using positional xpath - selects the first button in the
                   first header, which is Post LC (the primary view header is
                   restored in x_lc_header_studio_ported.xml with Post LC as
                   the first button and Amend LC as the second). -->
              <xpath expr="//header[1]/button[1]" position="after">
                <field widget="statusbar" name="selection_field_yo4qM"/>
              </xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="force_save">True</attribute>
                <attribute name="string">Registration No</attribute>
              <attribute name="readonly">1</attribute></xpath>
              <xpath expr="//group[@name='studio_group_535d1b_left']" position="inside">
                <field name="created_from_purchase_order" string="Ref. PO" force_save="True" readonly="1" invisible="created_from_purchase_order == False"/>
                <field name="version_no" string="Version No" force_save="True" readonly="1"/>
                <field name="accounting_company_id" string="Company"/>
              </xpath>
              <xpath expr="//group[@name='studio_group_535d1b']" position="after">
                <notebook name="studio_notebook_NOcl4">
                  <page string="General" name="studio_page_NOcl4">
                    <group name="studio_group_NOcl4">
                      <group name="studio_group_NOcl4_left" string="Letter of Credit">
                        <field name="indent_no" string="Indent No" required="1" readonly="status != 'Draft'"/>
                        <field name="date_of_receipt" string="Date of Receipt" required="1" readonly="status != 'Draft'"/>
                        <field name="lc_credit_type" string="Documentary Credit Type (40A)" required="1" readonly="status != 'Draft'"/>
                        <field name="lc_credit_sub_type" string="Documentary Credit Sub Type (40A)" readonly="status != 'Draft'"/>
                        <field name="lc_no" string="Documentatry Credit Number (20)" readonly="status != 'Draft'"/>
                        <field name="date_of_expiry" string="Date of Expiry (31D)" required="1" readonly="status != 'Draft'"/>
                        <field name="place_of_expiry" string="Place of Expiry (31D)" required="1" readonly="status != 'Draft'"/>
                      </group>
                      <group name="studio_group_NOcl4_right" string="General">
                        <field name="vendor" string="Vendor" readonly="status != 'Draft'"/>
                        <field name="beneficiary" string="Beneficiary (59)" force_save="True" readonly="1"/>
                        <field name="accounting_currency_id" string="Currency (32B)" required="1" readonly="status != 'Draft'"/>
                        <field name="lc_amount" string="LC Amount (32B)" readonly="status != 'Draft'"/>
                        <field name="lc_amount_lcy" string="LC Amount (LCY)"/>
                        <field name="tolerance" string="Tolerance (39A)" readonly="status != 'Draft'"/>
                        <field name="tolerance_type" string="Tolerance Type" readonly="status != 'Draft'"/>
                        <field name="revised_lc_amount" string="Revised Amount" force_save="True" readonly="1"/>
                        <field name="paid_amount_lcy" string="Paid Amount (LCY)" force_save="True" readonly="1"/>
                        <field name="status" string="Status" force_save="True" readonly="1"/>
                      </group>
                    </group>
                  </page>
                  <page string="Bank Details" name="studio_page_Q4El5">
                    <group name="studio_group_Q4El5">
                      <group name="studio_group_Q4El5_left">
                        <field name="issuing_bank" string="Issuing Bank" required="1" readonly="status != 'Draft'"/>
                        <field name="date_of_issue" string="Date of Issue (31C)" required="1" readonly="status != 'Draft'"/>
                      </group>
                      <group name="studio_group_Q4El5_right">
                        <field name="available_with_by" string="Available with / By (41A)" required="1" readonly="status != 'Draft'"/>
                        <field name="issuing_bank_reference_no_1" string="Issuing Bank Reference No" readonly="status != 'Draft'"/>
                      </group>
                    </group>
                  </page>
                  <page string="Terms" name="studio_page_qmu1S">
                    <group name="studio_group_qmu1S">
                      <group name="studio_group_qmu1S_left" string="Shipment Terms">
                        <field name="partial_shipment" string="Partial Shipment (43P)" readonly="status != 'Draft'"/>
                        <field name="transshipment" string="Transshipment (43T)" readonly="status != 'Draft'"/>
                        <field name="loading_on_board" string="Loading on Board (44A)" required="1" readonly="status != 'Draft'"/>
                        <field name="latest_shipment_date" string="Latest Shipment Date (44C)" required="1" readonly="status != 'Draft'"/>
                        <field name="transportation" string="Transportation (44B)" readonly="status != 'Draft'"/>
                        <field name="description_of_goods" string="Description of Goods and / or Services (45A)" readonly="status != 'Draft'"/>
                      </group>
                      <group name="studio_group_qmu1S_right" string="Payment Terms">
                        <field name="bank_charges" string="Bank Charges (71B)" readonly="status != 'Draft'"/>
                        <field name="draft" readonly="status != 'Draft'"/>
                        <field name="deferred_days" string="Deferred Days" readonly="status != 'Draft'"/>
                        <field name="period_for_presentation" string="Period for Presentation (48)" readonly="status != 'Draft'"/>
                        <field name="confirmation_instructions" string="Confirmation Instructions (49)" readonly="status != 'Draft'"/>
                        <field name="instruction_remarks" string="Instruction / Remarks (78)" readonly="status != 'Draft'"/>
                      </group>
                    </group>
                    <group name="studio_group_582X4">
                      <group name="studio_group_582X4_left" string="Documents Required">
                        <field name="document_required" string="Document Required (46A/B)" readonly="status != 'Draft'"/>
                        <field name="additional_conditions" string="Additional Conditions (47A/B)" readonly="status != 'Draft'"/>
                      </group>
                      <group name="studio_group_582X4_right"/>
                    </group>
                  </page>
                </notebook>
              </xpath>
            </data>
        </field>
    </record>
    <record id="view_default_list_view_for_lc_header_inherit_2" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for lc_header customization</field>
        <field name="model">lc_header</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_lc_header_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//tree[1]" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="default_order">name desc</attribute>
                <attribute name="delete">false</attribute>
                <attribute name="edit">false</attribute>
              </xpath>
              <xpath expr="//field[@name='sequence']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
              <xpath expr="//field[@name='sequence']" position="after">
                <field name="created_from_purchase_order" optional="show" string="PO Number"/>
                <field name="indent_no" optional="show"/>
                <field name="vendor" optional="show"/>
              </xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">LC Registration No</attribute>
              </xpath>
              <xpath expr="//field[@name='name']" position="after">
                <field name="status"/>
                <field name="accounting_currency_id" optional="show" string="Currency"/>
                <field name="issuing_bank" optional="show"/>
                <field name="lc_amount_lcy" optional="show"/>
                <field name="lc_amount" optional="show"/>
                <field name="revised_lc_amount"/>
                <field name="paid_amount_lcy" optional="show"/>
                <field name="date_of_receipt"/>
                <field name="lc_credit_type"/>
                <field name="lc_credit_sub_type"/>
                <field name="lc_no"/>
                <field name="date_of_expiry"/>
                <field name="version_no"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>

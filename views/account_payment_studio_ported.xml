<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_odoo_studio_account__b5367f7f_470f_43eb_bfb4_583117888f1f" model="ir.ui.view">
    <field name="name">Odoo Studio: account.payment.form customization</field>
    <field name="model">account.payment</field>
    <field name="key">studio_customization.odoo_studio_account__b5367f7f-470f-43eb-bfb4-583117888f1f</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
      <data>
      <field name="draft" invisible="1"/>
      <field name="state" invisible="1"/>
      <field name="x_studio_payment_validation" invisible="1"/>
        
        
        <xpath expr="//field[@name='payment_method_line_id']" position="after">
          <field name="x_studio_type" string="Type" readonly="state != 'draft'"/>
        </xpath>
        
        <xpath expr="//field[@name='payment_transaction_id']" position="after">
          <field name="x_studio_quotation_type" string="Quotation Type" force_save="True" invisible="1" readonly="1"/>
          <field name="x_studio_payment_validation_1" string="Payment Validation" force_save="True" readonly="1" invisible="x_studio_payment_validation == False"/>
          <field name="x_studio_advance_payment_acc_updated" force_save="True" readonly="1" invisible="1"/>
        </xpath>
      </data>
    </field>
  </record>
</odoo>

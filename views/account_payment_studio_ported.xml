<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_odoo_studio_account__b5367f7f_470f_43eb_bfb4_583117888f1f" model="ir.ui.view">
    <field name="name">Odoo Studio: account.payment.form customization</field>
    <field name="model">account.payment</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//button[@name='action_void_check']" position="after">
          
        </xpath>
        <xpath expr="//button[@name='action_post']" position="attributes">
          <attribute name="invisible">(state != 'draft') or ((x_studio_advance_payment_acc_updated == False) and (x_studio_type == 'Advance Payment'))</attribute></xpath>
        <xpath expr="//field[@name='payment_method_line_id']" position="after">
          <field name="x_studio_type" string="Type" readonly="state != 'draft'"/>
        </xpath>
        <xpath expr="//form[1]/sheet[1]/group[1]/group[@name='group2']/field[@name='partner_bank_id']" position="after">
          <field name="x_studio_sales_order" string="Sales Order" domain="[('partner_id', '=', partner_id)]" readonly="(partner_id == False) or (state != 'draft')"/>
          <field name="x_studio_project_no_1" string="Project No" readonly="(state != 'draft') or (x_studio_created_from_project_1 == True)"/>
          <field name="x_studio_created_from_project_1" string="Created From Project" force_save="True" readonly="1" invisible="1"/>
          <field name="x_studio_lc_no_1" string="LC No" domain="[('x_studio_vendor', '=', partner_id),('x_studio_status', '=', 'Posted')]" readonly="state != 'draft'"/>
          <field name="x_studio_purchase_order" string="Purchase Order" force_save="True" domain="[('partner_id', '=', partner_id)]" readonly="(partner_id == False) or (state != 'draft')"/>
          <field name="x_studio_tp_invoice_no" string="TP Invoice No" domain="[('x_studio_vendor', '=', partner_id)]" readonly="(partner_id == False) or (state != 'draft')"/>
          <field name="x_studio_payment_validation" string="Payment Validation" force_save="True" readonly="1" invisible="1"/>
        </xpath>
        <xpath expr="//field[@name='payment_transaction_id']" position="after">
          <field name="x_studio_quotation_type" string="Quotation Type" force_save="True" invisible="1" readonly="1"/>
          <field name="x_studio_payment_validation_1" string="Payment Validation" force_save="True" readonly="1" invisible="x_studio_payment_validation == False"/>
          <field name="x_studio_advance_payment_acc_updated" force_save="True" readonly="1" invisible="1"/>
        </xpath>
      </data>
    </field>
  </record>
</odoo>

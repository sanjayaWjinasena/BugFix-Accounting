<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- v0.0.55: bulk-port remaining Accounting act_window records. -->
  <record id="action_misc_charge_codes" model="ir.actions.act_window">
    <field name="name">Misc. Charge Codes</field>
    <field name="res_model">misc_charge_codes</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_misc_charge_codes_2" model="ir.actions.act_window">
    <field name="name">Misc. Charge Codes</field>
    <field name="res_model">misc_charge_codes</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_misc_charge_codes_form" model="ir.ui.view">
        <field name="name">Default form view for misc_charge_codes</field>
        <field name="model">misc_charge_codes</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="Misc Charge Codes">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                <field name="active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_d67062">
                  <group name="studio_group_d67062_left"/>
                  <group name="studio_group_d67062_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="view_misc_charge_codes_search" model="ir.ui.view">
        <field name="name">Default search view for misc_charge_codes</field>
        <field name="model">misc_charge_codes</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_misc_charge_codes" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_misc_charge_codes_list" model="ir.ui.view">
        <field name="name">Default list view for misc_charge_codes</field>
        <field name="model">misc_charge_codes</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_default_form_view_for_misc_charge_codes_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default form view for misc_charge_codes customization</field>
        <field name="model">misc_charge_codes</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_misc_charge_codes_form"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//form[1]" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="delete">false</attribute>
                <attribute name="edit">false</attribute>
              </xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Misc. Charge Code</attribute>
              </xpath>
              <xpath expr="//group[@name='studio_group_d67062_left']" position="inside">
                <field name="description" string="Description"/>
                <field name="charge_group" string="Charge Group" help="The grouping which determines whether the line is of a Charge, Duty or Tax."/>
                <field name="debit_acc_type" help="Whether the cost of the Charge/Duty/Tax to be loaded to the item or ledger."/>
                <!-- v141: x_studio_{charges,duties,taxes}_line_id moved to BugFix-Purchase; re-added there by views/x_misc_charge_codes_link_fields.xml -->
              </xpath>
            </data>
        </field>
    </record>
    <record id="view_default_list_view_for_misc_charge_codes_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for misc_charge_codes customization</field>
        <field name="model">misc_charge_codes</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_misc_charge_codes_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//tree[1]" position="attributes">
                <attribute name="default_order">charge_group,name asc</attribute>
                <attribute name="editable">bottom</attribute>
              </xpath>
              <xpath expr="//field[@name='sequence']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">system_entry == True</attribute></xpath>
              <xpath expr="//field[@name='name']" position="after">
                <field name="description" readonly="system_entry == True"/>
                <field name="charge_group" readonly="system_entry == True"/>
                <field name="debit_acc_type" string="Cost Load Type" required="1"/>
                <field optional="show" name="accounting_company_id" string="Company"/>
                <field name="debit_account" string="Debit Account" column_invisible="1" readonly="debit_acc_type == 'Item'"/>
                <field name="credit_acc_type" string="Credit Acc. Type" required="1" column_invisible="1"/>
                <field name="credit_account" string="Credit Account" column_invisible="1" readonly="credit_acc_type == 'Item'"/>
                <field name="system_entry" string="System Entry" column_invisible="1"/>
                <!-- v141: x_studio_{charges,duties,taxes}_line_id moved to BugFix-Purchase; re-added there by views/x_misc_charge_codes_link_fields.xml -->
              </xpath>
            </data>
        </field>
    </record>
</odoo>

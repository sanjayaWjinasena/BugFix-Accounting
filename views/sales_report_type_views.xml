<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_sales_report_type" model="ir.actions.act_window">
    <field name="name">Sales Report Type</field>
    <field name="res_model">sales_report_type</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_sales_report_type_form" model="ir.ui.view">
        <field name="name">Default form view for sales_report_type</field>
        <field name="model">sales_report_type</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="Sales Report Type">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                <field name="active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_cc42b9">
                  <group name="studio_group_cc42b9_left"/>
                  <group name="studio_group_cc42b9_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="view_sales_report_type_search" model="ir.ui.view">
        <field name="name">Default search view for sales_report_type</field>
        <field name="model">sales_report_type</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_sales_report_type" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_sales_report_type_list" model="ir.ui.view">
        <field name="name">Default list view for sales_report_type</field>
        <field name="model">sales_report_type</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_default_form_view_for_sales_report_type_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default form view for sales_report_type customization</field>
        <field name="model">sales_report_type</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_sales_report_type_form"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//group[@name='studio_group_cc42b9_left']" position="inside">
                <field name="journal_entry_id"/>
              </xpath>
              <xpath expr="//group[@name='studio_group_cc42b9']" position="after">
                <notebook name="studio_notebook_iwvn4">
                  <page string="New Page" name="studio_page_iwvn4">
                    <field name="journal_items_id" string="Journal Items Id">
                      <tree string="Journal Items" create="false" expand="context.get('expand', False)" multi_edit="1" js_class="account_move_line_list">
                        <field name="date" optional="show" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" optional="show"/>
                        <field name="move_id" optional="show"/>
                        <field name="account_id" optional="show" options="{'no_open': True, 'no_create': True}" domain="[('company_id', '=', company_id)]" groups="account.group_account_readonly"/>
                        <field name="statement_id" column_invisible="1"/>
                        <field name="partner_id" optional="show" readonly="1"/>
                        <field name="ref" optional="hide"/>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="reconciled" column_invisible="1"/>
                        <field name="matching_number" string="Matching" optional="show"/>
                        <field name="quantity"/>
                        <field name="reconcile_model_id" column_invisible="1"/>
                        <field name="date_maturity" optional="hide"/>
                        <field name="debit" sum="Total Debit" readonly="1"/>
                        <field name="credit" sum="Total Credit" readonly="1"/>
                        <field name="sales_team"/>
                        <field name="balance" sum="Total Balance" readonly="1" optional="hide"/>
                        <field name="amount_currency" readonly="1" groups="base.group_multi_currency"/>
                        <field name="currency_id" readonly="1" column_invisible="1"/>
                        <field name="company_currency_id" column_invisible="1"/>
                        <field name="parent_state" column_invisible="1"/>
                        <field name="tax_ids" widget="many2many_tags" width="0.5" optional="hide" readonly="1"/>
                        <field name="tax_tag_ids" widget="many2many_tags" width="0.5" optional="hide" string="Tax Grids" options="{'no_open': True, 'no_create': True}" domain="[('applicability', '=', 'taxes')]"/>
                        <groupby name="move_id">
                          <field name="state" invisible="1"/>
                          <button name="edit" type="edit" icon="fa-edit" title="Edit"/>
                          <button name="action_post" icon="fa-check" title="Post" type="object" groups="account.group_account_invoice" invisible="state not in ['draft']"/>
                          <button name="%(account.action_view_account_move_reversal)d" title="Reverse" icon="fa-refresh" type="action" groups="account.group_account_invoice" invisible="state not in ['posted']"/>
                          <button name="action_duplicate" icon="fa-files-o" title="Duplicate" type="object" groups="account.group_account_invoice"/>
                        </groupby>
                        <header>
                          <button name="action_reconcile" type="object" string="Reconcile" groups="account.group_account_user"/>
                          <button name="turn_as_asset" type="object" string="Create Asset" groups="account.group_account_user"/>
                        </header>
                        <field name="move_attachment_ids" column_invisible="1">
                          <tree>
                            <field name="mimetype"/>
                            <!--  We want to fetch the data for using it in the js-->
                          </tree>
                        </field>
                      <field name="company_id" column_invisible="1"/></tree>
                    </field>
                  </page>
                </notebook>
              </xpath>
            </data>
        </field>
    </record>
    <record id="view_default_list_view_for_sales_report_type_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for sales_report_type customization</field>
        <field name="model">sales_report_type</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_sales_report_type_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//tree[1]" position="attributes">
                <attribute name="editable">bottom</attribute>
              </xpath>
              <xpath expr="//field[@name='sequence']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Report Name</attribute>
              <attribute name="required">1</attribute></xpath>
              <xpath expr="//field[@name='name']" position="after">
                <field name="report_code" string="Report Code" required="1"/>
                <field name="id"/>
                <field name="journal_items_id"/>
                <field name="test" string="test"/>
                <!-- v0.0.32: 5 fields stripped (production_order_id [mrp cycle],
                     slow_moving_item_id / sales_prod_purch_id / prod_summary_split_id /
                     production_variance_id [stock cycle]). Restore path: upstream
                     sales_report_type to studio_usermodel_migration. -->
                <field name="journal_entry_id" string="Journal Entry Id"/>
                <field name="sales_lines_id" string="Sales Lines Id" column_invisible="1"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_rm_production_variance" model="ir.actions.act_window">
    <field name="name">RM Production Variance</field>
    <field name="res_model">rm_production_varian</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_rm_production_varian_form" model="ir.ui.view">
        <field name="name">Default form view for rm_production_varian</field>
        <field name="model">rm_production_varian</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="RM Production Variance">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                <field name="active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_ef890f">
                  <group name="studio_group_ef890f_left"/>
                  <group name="studio_group_ef890f_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="view_rm_production_varian_search" model="ir.ui.view">
        <field name="name">Default search view for rm_production_varian</field>
        <field name="model">rm_production_varian</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_rm_production_varian" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_rm_production_varian_list" model="ir.ui.view">
        <field name="name">Default list view for rm_production_varian</field>
        <field name="model">rm_production_varian</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_default_list_view_for_rm_production_varian_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for rm_production_varian customization</field>
        <field name="model">rm_production_varian</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_rm_production_varian_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='sequence']" position="after">
                <field name="item_number" string="Item Number"/>
                <field name="production_id" string="Production Id"/>
                <field name="prod_qty" string="Prod. Qty"/>
                <field name="bom_item" string="BOM Item"/>
                <field name="description_1" string="Description"/>
                <field name="unit" string="Unit"/>
                <field name="bom_qty" string="BOM Qty"/>
                <field name="esti_qty" string="Esti. Qty"/>
                <field name="cons_qty" string="Cons. Qty"/>
                <field name="variance" string="Variance"/>
                <field name="avg_cost" string="Avg. Cost"/>
                <field name="total_cost" string="Total Cost"/>
                <field name="description" string="Description" column_invisible="1"/>
                <field name="header_reference" string="Header Reference" column_invisible="1"/>
                <field name="sales_report_model_id" string="Sales Report Model Id" column_invisible="1"/>
              </xpath>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
            </data>
        </field>
    </record>
</odoo>

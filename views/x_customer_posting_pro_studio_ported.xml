<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_f49a8f85_9bb2_43ef_8f4f_8b962b411265" model="ir.ui.view">
    <field name="name">Default form view for x_customer_posting_pro</field>
    <field name="model">x_customer_posting_pro</field>
    <field name="key">studio_customization.default_form_view_fo_f49a8f85-9bb2-43ef-8f4f-8b962b411265</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Customer Posting Profile">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_6195ed">
            <group name="studio_group_6195ed_left"/>
            <group name="studio_group_6195ed_right"/>
          </group>
          <group>
            <field name="x_studio_notes" placeholder="Type down your notes here..." nolabel="1"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="ported_default_list_view_fo_3031fe1e_398f_4098_9918_014ea6ba462f" model="ir.ui.view">
    <field name="name">Default list view for x_customer_posting_pro</field>
    <field name="model">x_customer_posting_pro</field>
    <field name="key">studio_customization.default_list_view_fo_3031fe1e-398f-4098-9918-014ea6ba462f</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="x_studio_sequence" widget="handle"/>
        <field name="x_name"/>
      </tree>
    </field>
  </record>
  <record id="ported_default_search_view__75c14789_fbd8_4c3b_9714_053aebf3de17" model="ir.ui.view">
    <field name="name">Default search view for x_customer_posting_pro</field>
    <field name="model">x_customer_posting_pro</field>
    <field name="key">studio_customization.default_search_view__75c14789-fbd8-4c3b-9714-053aebf3de17</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="x_name"/>
        <separator/>
        <filter string="Archived" name="archived_x_customer_posting_pro" domain="[['x_active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
</odoo>

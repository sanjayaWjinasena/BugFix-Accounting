<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_rm_sales_order_line" model="ir.actions.act_window">
    <field name="name">RM Sales Order Line</field>
    <field name="res_model">rm_sales_order_line</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_rm_sales_order_line_form" model="ir.ui.view">
        <field name="name">Default form view for rm_sales_order_line</field>
        <field name="model">rm_sales_order_line</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header/>
              <sheet string="RM Sales Order Line">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                <field name="active" invisible="1"/>
                <div class="oe_title">
                            <h1>
                                <field name="name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_725b1a">
                  <group name="studio_group_725b1a_left"/>
                  <group name="studio_group_725b1a_right"/>
                </group>
              </sheet>
              <div class="oe_chatter" name="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="message_ids"/>
                <field name="activity_ids"/>
              </div>
            </form>
        </field>
    </record>
    <record id="view_rm_sales_order_line_search" model="ir.ui.view">
        <field name="name">Default search view for rm_sales_order_line</field>
        <field name="model">rm_sales_order_line</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <search>
              <field name="name"/>
              <separator/>
              <filter string="Archived" name="archived_rm_sales_order_line" domain="[['active', '=', False]]"/>
              <separator/>
            </search>
        </field>
    </record>
    <record id="view_rm_sales_order_line_list" model="ir.ui.view">
        <field name="name">Default list view for rm_sales_order_line</field>
        <field name="model">rm_sales_order_line</field>
        <field name="type">tree</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_default_list_view_for_rm_sales_order_line_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: Default list view for rm_sales_order_line customization</field>
        <field name="model">rm_sales_order_line</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Accounting.view_rm_sales_order_line_list"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute></xpath>
              <xpath expr="//field[@name='name']" position="after">
                <field name="sales_report_model_id" string="Sales Report Model Id"/>
                <field name="customer_acc" string="Customer Acc"/>
                <field name="customer_group" string="Customer Group"/>
                <field name="accounting_name" string="Name"/>
                <field name="product_1" string="Product"/>
                <field name="sales_order" string="Sales Order"/>
                <field name="invoice" string="Invoice"/>
                <field name="date" string="Date"/>
                <field name="product_category" string="Product Category"/>
                <field name="quantity" string="Quantity"/>
                <field name="unit_price" string="Unit Price"/>
                <field name="total_base_price" string="Total Base Price"/>
                <field name="disc_amount" string="Disc. Amount"/>
                <field name="disc_" string="Disc (%)"/>
                <field name="net_value" string="Net Value"/>
                <field name="inv_address" string="Inv. Address"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>
